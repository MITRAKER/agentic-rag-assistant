# Copy to .env and adjust. Every value has a sensible default.

# Where Qdrant lives. Leave QDRANT_URL empty to use an embedded, on-disk
# database in QDRANT_PATH (no server needed). Set it to e.g.
# http://localhost:6333 to use a Qdrant server (docker run -p 6333:6333 qdrant/qdrant).
RAG_QDRANT_URL=
RAG_QDRANT_PATH=./qdrant_data
RAG_COLLECTION=documents

# Embedding backend: "fastembed" (real semantic model, downloads ~130 MB once)
# or "hashing" (tiny offline fallback, used by the tests).
RAG_EMBEDDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking, measured in characters.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
