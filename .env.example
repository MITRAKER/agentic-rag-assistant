# Copy to .env and adjust. Every value has a sensible default.

# Where Qdrant lives. Leave QDRANT_URL empty to use an embedded, on-disk
# database in QDRANT_PATH (no server needed). Set it to e.g.
# http://localhost:6333 to use a Qdrant server (docker run -p 6333:6333 qdrant/qdrant).
RAG_QDRANT_URL=
RAG_QDRANT_PATH=./qdrant_data
RAG_COLLECTION=documents

# Embedding backend: "fastembed" (real semantic model, downloads ~130 MB once)
# or "hashing" (tiny offline fallback, used by the tests).
RAG_EMBEDDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking, measured in characters.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Retrieval
RAG_TOP_K=5
# Drop chunks whose cosine similarity is below this (0 keeps the top_k regardless).
RAG_MIN_SCORE=0

# Reranking: vector search fetches RAG_RERANK_CANDIDATES chunks (1 to 200), a
# reranker reads each one next to the question, and the best RAG_TOP_K are kept.
#   auto           the cross-encoder with fastembed, the lexical reranker with hashing
#   cross-encoder  a small model that scores (question, chunk) pairs (downloads ~80 MB once)
#   lexical        offline: fuses the vector order with a keyword-overlap order
#   none           keep the vector search order
RAG_RERANKER=auto
RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_RERANK_CANDIDATES=20

# Answering: "claude" (generative, needs an API key) or "extractive"
# (offline, picks matching sentences; free, used by the tests).
RAG_LLM=claude
RAG_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: how much the model thinks before answering.
RAG_LLM_EFFORT=medium
# Cap on each reply, thinking included: 1 to 128000.
RAG_LLM_MAX_TOKENS=16000
RAG_LLM_FALLBACKS=true

# The agent (rag ask --agent, needs RAG_LLM=claude). Claude chooses its own
# tools; these limits make sure every question ends.
# Model replies per attempt (2 to 30) and uses of each tool per attempt (1 to 20).
RAG_AGENT_MAX_TURNS=8
RAG_AGENT_TOOL_BUDGET=4
# Web search and web fetch run on Anthropic's servers; each search is billed.
RAG_AGENT_WEB=true
# Live facts about Python packages from PyPI: an example of an API tool.
RAG_AGENT_PYPI=true
# A second, smaller model checks the answer against the passages it cites,
# and the agent revises a failed answer up to RAG_AGENT_RETRIES times (0 to 3).
RAG_AGENT_SELF_CHECK=true
RAG_AGENT_CHECK_MODEL=claude-haiku-5-5
RAG_AGENT_RETRIES=1

# Your Anthropic API key (https://platform.claude.com). Never commit a real key.
ANTHROPIC_API_KEY=
